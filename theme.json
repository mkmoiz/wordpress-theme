{
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "840px",
            "wideSize": "1320px"
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "\"Inter\", sans-serif",
                    "name": "Inter",
                    "slug": "body"
                },
                {
                    "fontFamily": "\"Orbitron\", sans-serif",
                    "name": "Orbitron",
                    "slug": "heading"
                },
                {
                    "fontFamily": "\"Roboto Mono\", monospace",
                    "name": "Roboto Mono",
                    "slug": "mono"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "1.25rem",
                    "slug": "large"
                },
                {
                    "name": "Extra Large",
                    "size": "1.5rem",
                    "slug": "x-large"
                },
                {
                    "name": "Heading S",
                    "size": "1.75rem",
                    "slug": "heading-s"
                },
                {
                    "name": "Heading M",
                    "size": "2.25rem",
                    "slug": "heading-m"
                },
                {
                    "name": "Heading L",
                    "size": "3rem",
                    "slug": "heading-l"
                },
                {
                    "name": "Heading XL",
                    "size": "4.5rem",
                    "slug": "heading-xl"
                }
            ]
        },
        "color": {
            "palette": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#0d6efd"
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "color": "#7c3aed"
                },
                {
                    "name": "Dark Background",
                    "slug": "dark-bg",
                    "color": "#121212"
                },
                {
                    "name": "Card Background",
                    "slug": "card-bg",
                    "color": "#1e1e1e"
                },
                {
                    "name": "Text Main",
                    "slug": "text-main",
                    "color": "#e0e0e0"
                },
                {
                    "name": "Text Muted",
                    "slug": "text-muted",
                    "color": "#a0a0a0"
                },
                {
                    "name": "White",
                    "slug": "white",
                    "color": "#ffffff"
                }
            ]
        },
        "spacing": {
            "spacingScale": {
                "steps": 0
            },
            "units": [ "px", "em", "rem", "vh", "vw", "%" ]
        }
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "elements": {
            "h1": {
                "fontFamily": "var(--wp--preset--font-family--heading)",
                "fontSize": "var(--wp--preset--font-size--heading-l)",
                "fontWeight": "800"
            },
            "h2": {
                "fontFamily": "var(--wp--preset--font-family--heading)",
                "fontSize": "var(--wp--preset--font-size--heading-m)",
                "fontWeight": "700"
            },
            "h3": {
                "fontFamily": "var(--wp--preset--font-family--heading)",
                "fontSize": "var(--wp--preset--font-size--heading-s)",
                "fontWeight": "700"
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--white)"
                },
                "border": {
                    "radius": "2px"
                }
            }
        }
    }
}
